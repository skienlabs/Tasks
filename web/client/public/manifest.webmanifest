{
  "id": "/",
  "name": "Tasks",
  "short_name": "Tasks",
  "description": "Plan each day and get things done.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#000000",
  "theme_color": "#000000",
  "categories": ["productivity"],
  "icons": [
    { "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" },
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New task", "short_name": "New", "url": "/?new=1", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Summary", "url": "/?v=summary", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
